# Managed Postgres (Neon or Supabase). Payload creates its own schema on first run.
DATABASE_URL=postgres://user:password@host/prumo

# Signs Payload's tokens. Generate one per environment: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Public origin, used for canonical URLs, the OG image and proposal links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Object storage for renders and floor plans. Two adapters are wired in payload.config.ts —
# leave both empty in development and uploads fall back to local disk.

# Vercel Blob — what the first deploy actually uses (`vercel blob create-store`).
BLOB_READ_WRITE_TOKEN=

# S3-compatible storage (Cloudflare R2) — the documented target in CLAUDE.md, not yet
# provisioned. Takes priority over Vercel Blob when both are set.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
