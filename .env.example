# Managed Postgres (Neon or Supabase). Payload creates its own schema on first run.
DATABASE_URL=postgres://user:password@host/prumo

# Signs Payload's tokens. Generate one per environment: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Public origin, used for canonical URLs, the OG image and proposal links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# S3-compatible storage for renders and floor plans (Cloudflare R2).
# Leave empty in development: without these, uploads fall back to local disk.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
